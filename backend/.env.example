# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase (Storage for rendered videos)
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="videos"

# Script generation (OpenAI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"

# HeyGen (avatar video rendering)
HEYGEN_API_KEY=""
HEYGEN_AVATAR_ID=""
HEYGEN_VOICE_ID=""

# Meta Graph API (Facebook Page + Instagram Business account)
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# Scheduling webhook - Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Server
PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Exercise the full pipeline without spending HeyGen credits. Set to "true" during development.
DRY_RUN_HEYGEN="true"
DRY_RUN_META="true"
